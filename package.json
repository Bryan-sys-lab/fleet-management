{
  "name": "fleet-management",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "packages/*"
  ],
  "packageManager": "npm@11.17.0",
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "contract": "turbo run contract",
    "db:validate": "node db/validate.mjs",
    "db:validate:bash": "cd db && bash ./validate.sh",
    "db:types": "node scripts/generate-db-types.mjs",
    "db:types:check": "node scripts/generate-db-types.mjs --check",
    "dev:api": "npm run build && npm --workspace @fleet/api start",
    "dev:worker": "npm run build && npm --workspace @fleet/worker start",
    "dev:web": "next dev",
    "build:web": "next build",
    "start:web": "next start"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.3",
    "turbo": "^2.0.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.61.10",
    "@clerk/nextjs": "^7.9.16",
    "babel-plugin-module-resolver": "^5.0.3",
    "clsx": "^2.1.1",
    "expo": "^57.0.12",
    "lucide-react": "^1.58.0",
    "next": "^15.5.28",
    "prom-client": "^15.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "description": "A TypeScript/Node.js backend for an African fleet-operations platform (HQ Nairobi, `af-south-1`). It covers driver auth + MFA, shift/HOS duty cycles, fuel purchasing + reconciliation, accident mayday + escalation, DVIR inspections, trailer swaps, telemetry ingest from Traccar, anomaly detection, document expiry, and a real-time Socket.IO gateway.",
  "main": "license-checker.config.js",
  "directories": {
    "doc": "docs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zxds1/fleet-management.git"
  },
  "keywords": [],
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/zxds1/fleet-management/issues"
  },
  "homepage": "https://github.com/zxds1/fleet-management#readme"
}
