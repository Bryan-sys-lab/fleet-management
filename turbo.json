{
  "globalPassThroughEnv": [
    "WEBHOOK_SECRET",
    "SECURITY_ENFORCE",
    "DATABASE_URL",
    "REDIS_URL",
    "PG_INTEGRATION",
    "NODE_ENV",
    "CI"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "test": {
      "dependsOn": ["^build"]
    },
    "contract": {
      "dependsOn": ["^build"]
    }
  }
}
